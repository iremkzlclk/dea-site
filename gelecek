import numpy as np
import pandas as pd

from scipy.optimize import minimize


class PanelOptimizer:

    def __init__(
            self,
            results,
            df,
            input_columns,
            group_column="DMU"
    ):

        self.results = results
        self.df = df.copy()

        self.input_columns = input_columns
        self.group_column = group_column

        # Panel regresyon katsayıları
        self.coef = results.params.to_dict()

        # Sabit terim
        self.intercept = self.coef.pop("const", 0)

        print("\n--- Katsayılar ---")

        for k, v in self.coef.items():

            print(f"{k} : {v:.6f}")

    def objective(self, x):

        value = self.intercept

        for i, col in enumerate(self.input_columns):

            beta = self.coef.get(col, 0)

            value += beta * x[i]

        return -value



