    def optimize(
            self,
            current_values,
            max_change=0.20
    ):

        bounds = self.create_bounds(
            current_values,
            max_change
        )

        result = minimize(

            self.objective,

            x0=current_values,

            bounds=bounds,

            method="SLSQP"

        )

        return result

def get_latest_inputs(self):

    latest_rows = (
        self.df
        .sort_values("Donem")
        .groupby(self.group_column)
        .tail(1)
        .reset_index(drop=True)
    )

    return latest_rows